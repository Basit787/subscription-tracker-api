FROM node:24-alpine

# Set working directory
WORKDIR /app

# Enable Corepack
RUN corepack enable

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Install dependencies
RUN pnpm install

# Copy application source
COPY . .

# Expose application port
EXPOSE 3000

# Start development server
CMD ["pnpm", "dev"]